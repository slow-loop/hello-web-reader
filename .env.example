# Copy to `.env` (gitignored) and fill in. The project uses python-dotenv;
# the values below are read via os.environ.get(...) at runtime.

# --- Audio transcription Stage 2 (LLM polish, default deepseek/deepseek-v4-flash)
# Required by YouTube audio fallback and Apple Podcasts reader.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional override of the polishing model (must be an OpenRouter model slug).
# Examples: anthropic/claude-haiku-4.5, google/gemini-2.5-flash, openai/gpt-4o-mini
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# --- YouTube channel listing / Data API v3
# Required only for list_channel_videos / resolve_channel_id helpers.
YOUTUBE_API_KEY=

# Optional path to a cookies.txt for yt-dlp (helps with age-gated / private videos).
# YOUTUBE_COOKIES=/absolute/path/to/cookies.txt

# --- Web reader (optional Jina Reader fallback)
# When set, web.py can route through r.jina.ai for harder pages.
JINA_API_KEY=

# --- scripts/backup_store.sh (incremental archive backup)
# Local backup destination (e.g. a Google Drive desktop sync folder). No
# default — the script errors out if this isn't set here or via --backup-dir.
# BACKUP_DIR=/absolute/path/to/your/backup/destination
